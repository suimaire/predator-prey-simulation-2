# Supabase 프로젝트 설정 > API 에서 복사합니다.
# publishable key(구 anon key)는 브라우저에 노출되는 값이며, 실제 권한은
# supabase/schema.sql의 GRANT와 RLS가 제한합니다.
# service_role / secret key는 RLS를 우회하므로 절대 여기에 넣지 마세요.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# 선택 사항. 기본값은 아래와 같습니다.
# 제출(INSERT) 대상 원본 테이블 — 학생은 이 테이블을 읽을 수 없습니다.
# VITE_LEADERBOARD_TABLE=apex_leaderboard
# 조회(SELECT) 대상 공개 view — 기본값은 `${VITE_LEADERBOARD_TABLE}_public` 입니다.
# VITE_LEADERBOARD_PUBLIC_VIEW=apex_leaderboard_public
